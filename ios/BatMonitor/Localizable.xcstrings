    "home.empty.text": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu BMS por Bluetooth para ver su estado en tiempo real. No necesitas cuenta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your BMS over Bluetooth to see its live status. No account needed."
          }
        }
